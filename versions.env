# Versions and configuration actually used for the v0.1 run.
# Credential-free and safe to publish. These are the exact values from the run.

# Tool versions (captured from the lab host).
KIND_VERSION=v0.34.0-alpha+dd00511b043a27
KUBERNETES_VERSION=v1.37.0
KUBECTL_VERSION=v1.37.1
HELM_VERSION=v3.22.0
VCLUSTER_CLI_VERSION=0.37.2
VCLUSTER_SERVER_VERSION=v1.36.0
DOCKER_VERSION=29.8.1
DRAGONFLY_VERSION=2.5.2
DRAGONFLY_CHART_VERSION=1.8.5
# Deployed in manager-less mode (scheduler + seed peers + client DaemonSet).
# Client component image: v1.5.5. Seed peers scaled to 2 for a 2-worker layout.

# Kube contexts (disposable kind host + open source vClusters).
HOST_CONTEXT=kind-dragonfly-host
TENANT_A_CONTEXT=vcluster_tenant-a_tenant-a_kind-dragonfly-host
TENANT_B_CONTEXT=vcluster_tenant-b_tenant-b_kind-dragonfly-host

# Dragonfly on the host.
DRAGONFLY_NAMESPACE=dragonfly-system
DRAGONFLY_PROXY_PORT=4001
# Hugging Face serves this repo from its Xet CDN. The proxy mirrors this host.
CDN_HOST=us.aws.cdn.hf.co

# Namespace the tenant Job runs in, inside each tenant.
TENANT_JOB_NAMESPACE=default

# Public, pinned model artifact (both tenants request the same values).
MODEL_PROVIDER=huggingface
MODEL_REPOSITORY=distilbert-base-uncased
MODEL_REVISION=12040accade4e8a0f71eabdb258fecc2e7e948be
MODEL_FILE=model.safetensors
# Artifact size reported by Hugging Face (x-linked-size): 267954768 bytes.

# Container image used by the model-pull Job (has curl and sha256sum, non-root).
DOWNLOAD_IMAGE=curlimages/curl:latest
