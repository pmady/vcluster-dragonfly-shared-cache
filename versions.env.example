# Example configuration. Copy to versions.env and fill in.
# versions.env is credential-free and safe to commit. Do not put access tokens,
# kubeconfig data, or any other credentials in it.

# Tool versions, recorded for the evidence matrix.
KIND_VERSION=
KUBERNETES_VERSION=
KUBECTL_VERSION=
HELM_VERSION=
VCLUSTER_CLI_VERSION=
VCLUSTER_CHART_VERSION=
VCLUSTER_SERVER_VERSION=
DOCKER_VERSION=
DRAGONFLY_VERSION=
DRAGONFLY_CHART_VERSION=

# Kube contexts. The host runs Dragonfly. Each tenant reaches its own vCluster.
HOST_CONTEXT=
TENANT_A_CONTEXT=
TENANT_B_CONTEXT=

# Dragonfly on the host.
DRAGONFLY_NAMESPACE=dragonfly-system
DRAGONFLY_PROXY_PORT=4001
# CDN host the Hugging Face file redirects to. Find it with:
#   curl -sI "https://huggingface.co/<repo>/resolve/<rev>/<file>" | grep -i location
CDN_HOST=

# Namespace the tenant Job runs in, inside each tenant.
TENANT_JOB_NAMESPACE=default

# Public, pinned model artifact (both tenants request the same values).
MODEL_PROVIDER=huggingface
MODEL_REPOSITORY=
MODEL_REVISION=
MODEL_FILE=

# Container image for the model-pull Job (needs curl and sha256sum, runs
# non-root). curlimages/curl provides both via busybox. Pin an exact tag or
# digest, do not use latest.
DOWNLOAD_IMAGE=curlimages/curl:8.22.0
